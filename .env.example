# Harry the Marketer — copy to .env and fill in what you have. Everything is optional
# to START the app; missing pieces degrade gracefully (dev login, sandbox mailboxes,
# template emails).

# Where the app is reachable in the browser (Vite dev server in dev).
APP_URL=http://localhost:8131
PORT=8130

# SQLite directory. In production on Render, set to the disk mount (see render.yaml).
# DATA_DIR=/var/data

# --- Auth0 (https://auth0.com → create a Regular Web Application) ---
# Allowed Callback URL:  http://localhost:8131/api/auth/callback
# Allowed Logout URL:    http://localhost:8131/login
# Production callback:   https://harrythemarketer.com/api/auth/callback
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Optional. API identifier in Auth0 (Applications → APIs). Enables skipping Authorize App.
# AUTH0_AUDIENCE=https://harrythemarketer.com/api

# Force-enable/disable the local dev login (default: enabled only while Auth0 is unset)
# Production: DEV_LOGIN=0 (set in render.yaml)
# DEV_LOGIN=1

# --- Google OAuth for Gmail sending/reading (https://console.cloud.google.com) ---
# Brand the OAuth consent screen as "Harry The Marketer". Keep status Testing and add
# Test users until Google verification is approved — see GOOGLE-OAUTH-VERIFICATION.md.
# Authorized redirect URI: http://localhost:8131/api/google/callback
# Production redirect:     https://harrythemarketer.com/api/google/callback
# Privacy / Terms (served by this app): {APP_URL}/privacy  {APP_URL}/terms
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set after Google approves OAuth verification (Publishing status = In production).
# Until then stay in Testing and manage Audience → Test users in Cloud Console.
# GOOGLE_OAUTH_VERIFIED=1

# --- Microsoft OAuth for Outlook / Microsoft 365 (https://portal.azure.com) ---
# App registration → Authentication → redirect URI (Web):
#   http://localhost:8131/api/microsoft/callback
#   https://harrythemarketer.com/api/microsoft/callback
# API permissions: Mail.Send, Mail.Read, User.Read, offline_access
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- AI agent (composes emails, classifies replies, plans goals, researches leads).
#     OpenAI is preferred when its key is set; Claude is the alternative. Without
#     either, deterministic templates + a keyword classifier keep everything working. ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# AI_PROVIDER=auto   # openai | anthropic | auto

# Engine tick interval in ms (default 20000)
# ENGINE_INTERVAL_MS=20000

# --- Public marketing site ---------------------------------------------------
# Operator details rendered into the legal pages (/privacy, /terms, /dpa, ...).
# Leave unset in development; the pages then say "to be confirmed" and the server
# warns about it on a production boot. Set them before going live.
LEGAL_ENTITY_NAME=
LEGAL_JURISDICTION=
LEGAL_PRIVACY_EMAIL=
LEGAL_SUPPORT_EMAIL=

# Keep the whole site out of search indexes (set this on staging deployments).
# SITE_NOINDEX=1

# Set when running behind a reverse proxy / PaaS so req.ip, HSTS, and rate
# limiting read the forwarded headers instead of the proxy's own address.
# Required on Render: TRUST_PROXY=1
# TRUST_PROXY=1

# Exit on boot if production env is unsafe (Auth0 missing, dev login on, localhost APP_URL, etc.)
# PRODUCTION_STRICT=1

# --- Twilio SMS (optional) ---
# When Account SID + Auth Token + From number (or Messaging Service) are set,
# Harry auto-connects SMS for every workspace — no Settings click required.
# Webhook URL (Twilio Console → Phone number → Messaging):
#   {APP_URL}/api/hooks/twilio/sms
# Local: tunnel (ngrok) so Twilio can reach you, or use a sandbox account in Settings.
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+61xxxxxxxxx
# TWILIO_PHONE_NUMBER=+61xxxxxxxxx   # alias for TWILIO_FROM_NUMBER
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx
# Dev only — never in production:
# TWILIO_SKIP_SIGNATURE=1

# --- Stripe (hosted Payment Links — see PROVISIONING-RUNBOOK.md) -------------
# Webhook URL: {APP_URL}/api/billing/webhook
# Local forward: stripe listen --api-key $STRIPE_SECRET_KEY --forward-to localhost:8130/api/billing/webhook
# Checkout promo codes (create in Stripe): node scripts/stripe-promo-codes.mjs
#   Squadinstitlute — 10% off · BISM1 / HARRYFREE — 100% off
# NOTE: the LIVE payment links (buy.stripe.com/...) differ from the test ones
# (buy.stripe.com/test_...). Billing stays OFF until STRIPE_SECRET_KEY is set.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PAYMENT_LINK_STARTER=https://buy.stripe.com/...
# STRIPE_PAYMENT_LINK_GROWTH=https://buy.stripe.com/...
# STRIPE_PAYMENT_LINK_SCALE=https://buy.stripe.com/...

# --- Optional AI mode toggle -------------------------------------------------
# AI_MODE controls how aggressively the agent runs (default: full agentic).
# Set to a reduced mode to disable per-lead web research etc.
# AI_MODE=

# --- External data providers (all optional; each degrades honestly when unset) ---
# Prospect search / contact enrichment. Both halves (URL + KEY) required to enable.
# PROSPECT_API_URL=
# PROSPECT_API_KEY=
# Sender-account provisioning + its billing key.
# SENDERS_API_URL=
# SENDERS_API_KEY=
# SENDERS_BILLING_KEY=
# Deliverability / spam-placement / blacklist checks.
# DELIVERABILITY_API_URL=
# DELIVERABILITY_API_KEY=
