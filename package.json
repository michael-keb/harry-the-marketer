{
  "name": "harry-the-marketer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Harry the Marketer — lead-generation platform where campaign playbooks are Mermaid diagrams executed by an AI agent against the live email chain.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node --watch server/index.js\" \"vite --config web/vite.config.js\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js && node scripts/postbuild.mjs",
    "start": "NODE_ENV=production node server/index.js",
    "test": "npm run test:server && npm run test:web",
    "test:server": "node --test tests/*.test.js",
    "test:web": "vitest run --config web/vitest.config.js",
    "routes": "node scripts/routes.mjs",
    "test:e2e": "node scripts/e2e-parity.mjs",
    "smoke:prod": "node scripts/production-smoke.mjs",
    "backup:db": "node scripts/backup-db.mjs",
    "matrix": "node scripts/requirements-matrix.mjs",
    "gallery": "node scripts/gallery.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "check:layout": "node scripts/layout-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "better-sqlite3": "^12.4.1",
    "express": "^4.21.2",
    "openai": "^7.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "jsdom": "^30.0.1",
    "mermaid": "^11.12.1",
    "playwright-core": "^1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "tailwindcss": "^4.1.16",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  }
}
